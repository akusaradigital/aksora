# ============================================================
# Copy file ini menjadi .env dan isi nilainya
# ============================================================

# Production: Neon/Postgres
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"
RESET_SECRET="use-a-random-string"

# Local development:
# Leave DATABASE_URL empty to use SQLite automatically.

# Auth
AUTH_SECRET="use-a-long-random-string"
SESSION_TTL_HOURS=6
LOG_LEVEL=info
SEED_ADMIN_NAME="use-admin-name"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="use-a-strong-password"

# SEO / Public URL
NEXT_PUBLIC_BASE_URL="https://aksora.akusaraproject.my.id"

# Google Sign-In (client ID from Google Cloud OAuth consent screen).
# GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"

# Weekly report email cron (optional — feature is disabled without these)
# Get a key at https://resend.com (free tier: 3,000 emails/mo)
# RESEND_API_KEY="re_..."
# RESEND_FROM="Aksora <onboarding@resend.dev>"
# CRON_SECRET="use-a-random-string"
# Recipients for /api/cron/health-monitor breach alerts (comma-separated emails).
# HEALTH_ALERT_EMAIL="ops@example.com"
