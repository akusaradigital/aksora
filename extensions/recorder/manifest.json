{
  "manifest_version": 3,
  "name": "Aksora Recorder",
  "version": "0.1.0",
  "description": "Record a browser flow and send it to Aksora to become a test case.",
  "permissions": ["storage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Aksora Recorder" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ]
}
